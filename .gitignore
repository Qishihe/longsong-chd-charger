# ── 系统与编辑器垃圾 ──
Thumbs.db
desktop.ini
.DS_Store

# ── 依赖与缓存 ──
__pycache__/
*.py[cod]
node_modules/
.wrangler/

# ── 密钥：一律不入库 ──
# 高德 Key 与安全密钥（模板见 campus-pile-kit/chd-charge/map-key.example.js）
*.local.js
*.local.json
.env
.env.*
*.key
*.pem
# Fiddler 抓包存档：内含 Authorization: Bearer <token> 明文。
# ⚠️ 必须写成不带目录前缀的 `*.saz`，gitignore 的 `*` 不跨目录。
*.saz

# ── 构建产物：由 tools/ 里的脚本从 chd-charge/ 重新生成 ──
campus-pile-kit/dist-*/
campus-pile-kit/*.zip

# ── 本机运行数据 ──
campus-pile-kit/data/history/
*.log

# ── 发布记录类文档：会贴 Key 与凭证原文 ──
发布指令*.md

# ── 本地快照与过程材料：只留本地，不上仓库 ──
# versions-chd/ 是逐版 HTML 快照，回滚用；体积 20MB+ 且全是重复源码
campus-pile-kit/versions-chd/
# scratch/ 是一次性探测脚本与验收脚本
scratch/
campus-pile-kit/scratch/

# ── AI 协作者的工作目录 ──
.workbuddy/
.wbapp_*.genie

# ── 第三方参考仓库：独立克隆，自带 .git，且其许可为「保留所有权利」，不随本仓库分发 ──
stu-charge-watch/
