# ── 系统与编辑器垃圾 ──
Thumbs.db
desktop.ini
.DS_Store

# ── 依赖与缓存 ──
__pycache__/
*.py[cod]
node_modules/
.wrangler/

# ── 密钥：一律不入库 ──
# 高德 Key 与安全密钥（模板见 campus-pile-kit/chd-charge/map-key.example.js）
*.local.js
*.local.json
.env
.env.*
*.key
*.pem
# Fiddler 抓包存档：内含 Authorization: Bearer <token> 明文。
# ⚠️ 必须写成不带目录前缀的 `*.saz`，gitignore 的 `*` 不跨目录。
*.saz

# ── 构建产物：由 tools/ 里的脚本从 chd-charge/ 重新生成 ──
campus-pile-kit/dist-*/
campus-pile-kit/*.zip
# 对外设备目录：由 tools/gen_catalog.py 在打包时生成，属构建产物
# （仓库里出现副本会形成第二个真源）
campus-pile-kit/chd-charge/catalog.json

# ── 本机运行数据 ──
campus-pile-kit/data/history/
*.log

# ── 发布记录类文档：会贴 Key 与凭证原文 ──
发布指令*.md

# ── 本地快照与过程材料：只留本地，不上仓库 ──
# versions-chd/ 是逐版 HTML 快照，回滚用；体积 20MB+ 且全是重复源码
campus-pile-kit/versions-chd/
# scratch/ 是一次性探测脚本与验收脚本
scratch/
campus-pile-kit/scratch/
# backups/ 是改版前手存的 index.html / sw.js 副本，只用于本机回滚。
# 2026-11-22 v3.39：这些副本曾被 make_cloudflare.py 打进产物（6.5MB，全是旧版首页），
# 所以既要挡在仓库外，也要挡在打包外（见 make_cloudflare.py 的 EXCLUDE_SUFFIXES）。
campus-pile-kit/backups/

# ── AI 协作者的工作目录 ──
.workbuddy/
.wbapp_*.genie

# ── 第三方参考仓库：独立克隆，自带 .git，且其许可为「保留所有权利」，不随本仓库分发 ──
stu-charge-watch/

# ── 私有真值清单：真实设备编号，**绝不能入库** ──
# 打包注入（tools/inject_private.py）与快照部署（gen_snapshot_partitions.py --inject）
# 都靠它；丢了等于丢了整份设备清单。
campus-pile-kit/private/
# 快照 Worker 的注入部署副本（含真号，由 gen_snapshot_partitions.py --inject 生成）
campus-pile-kit/snapshot-worker/.deploy/
